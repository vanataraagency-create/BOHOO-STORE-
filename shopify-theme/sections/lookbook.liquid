<section id="lookbook">
  {% for block in section.blocks %}
    {% case block.settings.layout %}
      {% when 'split' %}
        <div class="lb-panel lb-p1" {{ block.shopify_attributes }}>
          <div class="lb-img">
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.heading }}" loading="lazy">
            {% endif %}
          </div>
          <div class="lb-text">
            <div class="lb-look">{{ block.settings.label | default: 'LOOK 01' }}</div>
            <h3 class="lb-h">{{ block.settings.heading }}</h3>
            <p class="lb-body">{{ block.settings.body }}</p>
            <div class="lb-tags">
              {% if block.settings.tag1 != blank %}
                <div class="lb-tag"><span>{{ block.settings.tag1 }}</span><span class="lb-add">→ ADD</span></div>
              {% endif %}
              {% if block.settings.tag2 != blank %}
                <div class="lb-tag"><span>{{ block.settings.tag2 }}</span><span class="lb-add">→ ADD</span></div>
              {% endif %}
            </div>
          </div>
        </div>

      {% when 'wide' %}
        <div class="lb-panel lb-p2" {{ block.shopify_attributes }}>
          <div class="lb-img">
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.heading }}" loading="lazy">
            {% endif %}
          </div>
          <div class="lb-text">
            <div class="lb-look">{{ block.settings.label | default: 'LOOK 02' }}</div>
            <h3 class="lb-h">{{ block.settings.heading }}</h3>
            <p class="lb-body">{{ block.settings.body }}</p>
            <div class="lb-tags">
              {% if block.settings.tag1 != blank %}
                <div class="lb-tag"><span>{{ block.settings.tag1 }}</span><span class="lb-add">→ ADD</span></div>
              {% endif %}
              {% if block.settings.tag2 != blank %}
                <div class="lb-tag"><span>{{ block.settings.tag2 }}</span><span class="lb-add">→ ADD</span></div>
              {% endif %}
            </div>
          </div>
        </div>

      {% when 'full' %}
        <div class="lb-panel lb-p3" style="min-height:80vh;position:relative" {{ block.shopify_attributes }}>
          <div class="lb-p3-inner" style="width:100%;height:100%;min-height:80vh">
            <div class="lb-ss25">SS25</div>
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 1920 }}" alt="{{ block.settings.heading }}" loading="lazy" style="width:100%;height:80vh;object-fit:cover;filter:brightness(.45)">
            {% endif %}
            <div class="lb-p3-text">
              <div class="lb-look">{{ block.settings.label | default: 'LOOK 03' }}</div>
              <h3 class="lb-h">{{ block.settings.heading }}</h3>
              {% if block.settings.cta_text != blank %}
                <a href="{{ block.settings.cta_link | default: '/collections/all' }}" class="btn-acid" style="display:inline-block;margin-top:20px">{{ block.settings.cta_text }}</a>
              {% endif %}
            </div>
          </div>
        </div>
    {% endcase %}
  {% endfor %}
</section>

{% schema %}
{
  "name": "Lookbook",
  "settings": [],
  "blocks": [
    {
      "type": "panel",
      "name": "Lookbook Panel",
      "settings": [
        { "type": "select", "id": "layout", "label": "Layout", "options": [
          { "value": "split", "label": "Split (50/50)" },
          { "value": "wide", "label": "Wide Image" },
          { "value": "full", "label": "Full Width" }
        ], "default": "split" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "label", "label": "Look Label", "default": "LOOK 01" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "body", "label": "Body Text" },
        { "type": "text", "id": "tag1", "label": "Product Tag 1" },
        { "type": "text", "id": "tag2", "label": "Product Tag 2" },
        { "type": "text", "id": "cta_text", "label": "CTA Text (full layout only)" },
        { "type": "url", "id": "cta_link", "label": "CTA Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook"
    }
  ]
}
{% endschema %}
